generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  username        String   @unique
  passwordHash    String
  streak          Int
  wasToday        Boolean
  weeklyActivity  WeeklyActivity
}

model Project {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  active          Boolean
  userId          String   
  title           String
  skills          Skill[]
  steps           Step[]
}

model Skill {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String    
  createdAt      DateTime  @default(now())
  updatedAt      Int
  stepIDs        String[]
  lessonsAmount  Int
  currentLesson  Int
  level          Int
  Project       Project? @relation(fields: [projectId], references: [id])
  projectId     String    @db.ObjectId
  lineNumber     Int
}

model Step {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  stepType          String
  answer            String
  parentLessonId    String
  Project          Project? @relation(fields: [projectId], references: [id])
  projectId        String?   @db.ObjectId
  options           String?
}

type Variant {
  idx         Int
  type        String?
  value       String
  isFocused   Boolean
  isConnected Boolean?
}

type WeeklyActivity {
  Sun   Int
  Mon   Int
  Tue   Int
  Wed   Int
  Thu   Int
  Fri   Int
  Sat   Int
}